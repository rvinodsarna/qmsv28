[[headers]]
  for = "/*"
  [headers.values]
    X-Frame-Options = "SAMEORIGIN"
    X-Content-Type-Options = "nosniff"
    Referrer-Policy = "strict-origin-when-cross-origin"
    Permissions-Policy = "geolocation=(), microphone=(), camera=(self)"

# ─── Block public access to source/data files that are NOT used by the live app ───
# app.js and styles.css ARE served (index.html now loads them externally as of the
# code-externalization change) and must NOT be blocked here. config.js below is a
# stale/unused artifact (the real Supabase config is inlined in app.js) and the
# remaining entries are raw student/staff data and password-hash exports — 404 them
# explicitly rather than relying on directory-listing being off.
[[redirects]]
  from = "/*.sql"
  to = "/404.html"
  status = 404
  force = true

[[redirects]]
  from = "/*.csv"
  to = "/404.html"
  status = 404
  force = true

